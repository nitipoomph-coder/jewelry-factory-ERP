# Copy this file to .env and fill in your actual values
# Do not commit the real .env file.

DB_HOST=your-db-server.local
DB_PORT=1433
DB_NAME=dbGeneration
DB_USER=your-db-user
DB_PASS="your-password"
PORT=3001

# Photo Bridge network folders (semicolon-separated)
PHOTO_PS_DIRS="\\\\your-file-server\\Photo\\Cost"
PHOTO_CAD_DIRS="\\\\your-file-server\\Photo\\Mold;\\\\your-file-server\\Photo\\MoldCAD"

# Auth config
JWT_SECRET="your-jwt-secret-key"
APP_SALES_PASSWORD="sales-password"
APP_ADMIN_PASSWORD="admin-password"